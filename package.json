{
  "name": "jp2-ascii",
  "version": "1.0.1",
  "description": "Jan Paweł II in your console, as ASCII",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "ascii.js",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npm --prefix .gen install --no-fund --no-audit && node .gen/generate.mjs",
    "generate": "npm run build",
    "example": "npm --prefix example install --no-fund --no-audit && npm --prefix example start",
    "example:esm": "npm --prefix example install --no-fund --no-audit && npm --prefix example run start:esm",
    "start": "npm run example",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "jp2-ascii",
    "jpii",
    "ascii",
    "jan-pawel-ii",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lefjuu/jp2-ascii.git"
  },
  "bugs": {
    "url": "https://github.com/Lefjuu/jp2-ascii/issues"
  },
  "homepage": "https://github.com/Lefjuu/jp2-ascii#readme"
}
